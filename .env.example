# Copier ce fichier en .env puis remplir TOUTES les valeurs (aucun secret dans Git).
# Mots de passe Wazuh : 8 a 64 caracteres avec majuscule, minuscule, chiffre et symbole.
INDEXER_PASSWORD=CHANGE_ME
DASHBOARD_PASSWORD=CHANGE_ME
API_PASSWORD=CHANGE_ME

# Cle publique SSH autorisee sur le serveur web.
SSH_PUBLIC_KEY=

# Necessaire pour le profil base de donnees.
MARIADB_ROOT_PASSWORD=
